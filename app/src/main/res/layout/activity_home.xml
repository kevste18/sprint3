<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HomeActivity"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/black">


    <ImageView
        android:id="@+id/imgVelada"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/velada"
        android:contentDescription="@string/poster"/>

    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/velada"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:textSize="34sp"
        android:textColor="@color/white"
        />

    <TextView
        android:id="@+id/txtSubtitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ubicacion"
        android:layout_gravity="center"
        android:textSize="22sp"
        android:textColor="@color/white"
        />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:layout_gravity="center_horizontal">

    <Button
        android:id="@+id/btnVerCartelera"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cartelera"
        android:layout_gravity="center"
        android:textSize="18sp"
        android:textColor="@color/white"
        android:background="@drawable/bg_boton_entradas"
        app:backgroundTint="@null"
        android:layout_marginEnd="12dp"
        />

    <Button
        android:id="@+id/btnComprar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/entradas"
        android:layout_gravity="center"
        android:textSize="18sp"
        android:textColor="@color/white"
        android:background="@drawable/bg_boton_entradas"
        app:backgroundTint="@null"
        />

    </LinearLayout>


</androidx.appcompat.widget.LinearLayoutCompat>
